{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://targetscope.invalid/schemas/launcher/launcher_status_response.schema.json",
  "title": "launcher_status_response",
  "description": "doc/interfaces.md#launcher_status",
  "allOf": [
    {
      "$ref": "../common/response_envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "launcher_status_response"
    },
    "payload": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/payload"
        }
      ]
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "programs"
      ],
      "properties": {
        "programs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/program_status"
          }
        }
      },
      "additionalProperties": false
    },
    "program_status": {
      "type": "object",
      "required": [
        "name",
        "state",
        "restarts",
        "since_ms"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "state": {
          "enum": [
            "starting",
            "running",
            "backoff",
            "failed",
            "stopped"
          ]
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ]
        },
        "restarts": {
          "type": "integer"
        },
        "since_ms": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  }
}
