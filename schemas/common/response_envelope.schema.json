{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://targetscope.invalid/schemas/common/response_envelope.schema.json",
  "title": "ResponseEnvelope",
  "description": "doc/interfaces.md#response-envelope",
  "type": "object",
  "required": [
    "type",
    "version",
    "request_id",
    "status",
    "error",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*_response$"
    },
    "version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "error.schema.json"
        }
      ]
    },
    "payload": {}
  },
  "if": {
    "properties": {
      "status": {
        "const": "ok"
      }
    }
  },
  "then": {
    "properties": {
      "error": {
        "type": "null"
      },
      "payload": {
        "not": {
          "type": "null"
        }
      }
    }
  },
  "else": {
    "properties": {
      "error": {
        "$ref": "error.schema.json"
      },
      "payload": {
        "type": "null"
      }
    }
  }
}
