{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://targetscope.invalid/schemas/common/request_envelope.schema.json",
  "title": "Request envelope",
  "description": "doc/interfaces.md#request-envelope",
  "type": "object",
  "required": [
    "type",
    "version",
    "request_id",
    "payload"
  ],
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "reply_to": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z_]+:responses$"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
