{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://targetscope.invalid/schemas/common/shooter.schema.json",
  "title": "Shooter",
  "description": "doc/interfaces.md#shooter",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "retired": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
