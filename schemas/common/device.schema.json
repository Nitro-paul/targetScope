{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://targetscope.invalid/schemas/common/device.schema.json",
  "title": "Device",
  "description": "doc/interfaces.md#device",
  "type": "object",
  "required": [
    "name",
    "bullet_diameter_mm"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "caliber": {
      "type": [
        "string",
        "null"
      ]
    },
    "bullet_diameter_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "image_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "shot_count": {
      "type": "integer",
      "minimum": 0
    },
    "locked": {
      "type": "boolean"
    },
    "retired": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
