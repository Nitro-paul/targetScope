{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://targetscope.invalid/schemas/common/event_envelope.schema.json",
  "title": "Event envelope",
  "description": "doc/interfaces.md#event-envelope",
  "type": "object",
  "required": [
    "type",
    "version",
    "event_id",
    "source",
    "timestamp_ms",
    "payload"
  ],
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string"
    },
    "timestamp_ms": {
      "type": "integer"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
