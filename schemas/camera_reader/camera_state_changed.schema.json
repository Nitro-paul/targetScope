        },
        "message": {
          "type": "string"
        },
        "camera_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "width_px": {
          "type": [
            "integer",
            "null"
          ]
        },
        "height_px": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
