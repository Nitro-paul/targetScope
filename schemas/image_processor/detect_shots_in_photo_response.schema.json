{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://targetscope.invalid/schemas/image_processor/detect_shots_in_photo_response.schema.json",
  "title": "detect_shots_in_photo_response",
  "description": "doc/interfaces.md#detect_shots_in_photo",
  "allOf": [
    {
      "$ref": "../common/response_envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "detect_shots_in_photo_response"
    },
    "payload": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/payload"
        }
      ]
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "shots",
        "staged_file",
        "warnings"
      ],
      "properties": {
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "angle_turns",
              "radius_mm",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "angle_turns": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 1
              },
              "radius_mm": {
                "type": "number",
                "minimum": 0
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "staged_file": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
