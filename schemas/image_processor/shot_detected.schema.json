{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://targetscope.invalid/schemas/image_processor/shot_detected.schema.json",
  "title": "shot_detected",
  "description": "doc/interfaces.md#shot_detected",
  "allOf": [
    {
      "$ref": "../common/event_envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "shot_detected"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    },
    "source": {
      "const": "image_processor"
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "hole_id",
        "live_paper",
        "angle_turns",
        "radius_mm",
        "confidence",
        "frame_seq"
      ],
      "properties": {
        "hole_id": {
          "type": "integer"
        },
        "live_paper": {
          "type": "integer"
        },
        "angle_turns": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "radius_mm": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "frame_seq": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  }
}
